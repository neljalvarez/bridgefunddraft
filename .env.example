# BridgeFund environment variables
#
# Copy this file to `.env.local` and fill in your own values:
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real keys.
# Variables prefixed with NEXT_PUBLIC_ are embedded in the browser bundle,
# so only put values there that are safe to expose.

# --- Supabase (required for authentication and data) ---------------------
# Find these in your Supabase dashboard: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" (or "publishable") key. Safe for the browser ONLY because
# Row Level Security must be enabled on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- App -------------------------------------------------------------------
# Public base URL of the app; used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (not used yet) -----------------------------------
# If you later add admin tasks that bypass RLS, keep the service role key
# server-side only and NEVER prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
